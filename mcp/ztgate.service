[Unit]
Description=ztgate server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/ztgate/server.env
RuntimeDirectory=ztgate
RuntimeDirectoryMode=0700

# 감사 로그가 쌓이는 곳 (/var/log/ztgate). ProtectSystem=strict 아래에서 서버가 쓸 수 있는
# 곳은 systemd 가 이렇게 내준 디렉터리뿐이다.
LogsDirectory=ztgate
LogsDirectoryMode=0700

# 등록 코드로 온 기기를 서버가 기기 목록에 직접 올린다 (devices.conf 에 한 줄을 더하고
# enroll.conf 에서 쓰인 줄을 지운다). ProtectSystem=strict 는 /etc 를 읽기 전용으로
# 만들므로 이 디렉터리만 따로 연다.
ReadWritePaths=/etc/ztgate
ExecStart=/opt/ztgate/libexec/service.sh run
ExecStartPost=/opt/ztgate/libexec/service.sh tun-up $MAINPID
ExecReload=/bin/kill -HUP $MAINPID
ExecStopPost=/opt/ztgate/libexec/service.sh forward-down

# 죽으면 다시 올리되, 설정이 틀려 스스로 1 로 끝난 경우는 올려 봐야 같은 결과다.
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=1

# 서버는 패킷마다 한 줄씩 찍는다. journald 의 기본 제한에 걸리면 세션이 생기고
# 사라진 줄까지 버려지고, MCP 는 그 줄들로 현재 세션을 계산한다.
LogRateLimitIntervalSec=0

# TUN 을 만들고 주소를 붙이는 것 말고는 root 의 힘이 필요 없다.
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
