<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{5C2A9F13-4E86-4B0D-91A7-2D6C8F3B7E40}</ProjectGuid>
    <Keyword>MFCProj</Keyword>
    <RootNamespace>vpn_gui</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <!-- $(SolutionDir) 는 .sln 을 통해 빌드할 때만 정의된다. msbuild 로 이 .vcxproj 를
       직접 빌드해도 되도록 프로젝트 위치를 기준으로 삼는다. -->
  <PropertyGroup Label="Paths">
    <WindowsRoot>$(MSBuildProjectDirectory)\..</WindowsRoot>
    <RepoRoot>$(MSBuildProjectDirectory)\..\..</RepoRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- 설치된 VS의 기본 툴셋을 쓴다. VS2022는 v143, VS2026은 v145. -->
  <PropertyGroup Label="Toolset">
    <MyVpnToolset Condition="'$(DefaultPlatformToolset)'!=''">$(DefaultPlatformToolset)</MyVpnToolset>
    <MyVpnToolset Condition="'$(MyVpnToolset)'==''">v143</MyVpnToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(MyVpnToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseOfMfc>Dynamic</UseOfMfc>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(MyVpnToolset)</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
    <UseOfMfc>Dynamic</UseOfMfc>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <OutDir>$(WindowsRoot)\build\$(Configuration)\</OutDir>
    <IntDir>$(WindowsRoot)\build\obj\$(ProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <!-- C 파일(tunnel.c / vpn_session.c / proto.c)과 C++ 파일이 섞여 있어
           미리 컴파일된 헤더를 쓰지 않는다. PCH 는 언어마다 따로 만들어야 하고,
           C 파일이 pch.h(= MFC 헤더) 를 포함할 수는 없다. -->
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(RepoRoot)\lib\common\include;$(WindowsRoot)\core;$(WindowsRoot)\third_party\wintun\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- MFC 헤더가 windows.h 를 직접 다루므로 WIN32_LEAN_AND_MEAN 은 정의하지 않는다. -->
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- 소스가 UTF-8(BOM 없음)이다. 이 옵션이 없으면 한글 와이드 문자열 리터럴이 깨진다. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>ws2_32.lib;iphlpapi.lib;wscapi.lib;bcrypt.lib;crypt32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Wintun 어댑터 생성과 IP / MTU 설정에 관리자 권한이 필요하다.
           매니페스트에 박아 두면 실행할 때 Windows 가 권한 상승을 먼저 묻는다. -->
      <EnableUAC>true</EnableUAC>
      <UACExecutionLevel>RequireAdministrator</UACExecutionLevel>
      <!-- comctl32 v6 를 매니페스트에 선언해야 비주얼 스타일이 적용된다.
           없으면 버튼 / 리스트가 테마 없이 Win95 모양으로 그려진다. -->
      <AdditionalManifestDependencies>type='win32' name='Microsoft.Windows.Common-Controls' version='6.0.0.0' processorArchitecture='*' publicKeyToken='6595b64144ccf1df' language='*'</AdditionalManifestDependencies>
    </Link>
    <!-- DPI 를 인식한다고 선언하지 않으면 Windows 가 96 DPI 로 그린 창을 통째로 늘려
         125% / 150% 화면에서 글자가 뿌옇게 보인다. "시스템 DPI 인식"이다: 시작할 때의
         배율로 또렷하게 그리고, 배율이 다른 모니터로 옮기면 그때만 Windows 가 늘린다.
         모니터별 인식(PerMonitorV2)은 옮길 때마다 글꼴과 배치를 다시 잡아야 한다. -->
    <Manifest>
      <EnableDpiAwareness>true</EnableDpiAwareness>
    </Manifest>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <PostBuildEvent>
      <Command>copy /Y "$(WindowsRoot)\third_party\wintun\bin\amd64\wintun.dll" "$(OutDir)"</Command>
      <Message>Copy wintun.dll next to the executable</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="VpnGuiApp.cpp" />
    <ClCompile Include="MainDlg.cpp" />
    <ClCompile Include="EnrollDlg.cpp" />
    <ClCompile Include="PacketStore.cpp" />
    <ClCompile Include="ui_theme.cpp" />
    <ClCompile Include="ui_controls.cpp" />
    <ClCompile Include="..\core\vpn_session.c" />
    <ClCompile Include="..\core\tunnel.c" />
    <ClCompile Include="..\core\posture.c" />
    <ClCompile Include="..\core\hmac.c" />
    <ClCompile Include="..\core\device.c" />
    <ClCompile Include="..\..\lib\common\src\proto.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="framework.h" />
    <ClInclude Include="resource.h" />
    <ClInclude Include="VpnGuiApp.h" />
    <ClInclude Include="MainDlg.h" />
    <ClInclude Include="EnrollDlg.h" />
    <ClInclude Include="PacketStore.h" />
    <ClInclude Include="ui_theme.h" />
    <ClInclude Include="ui_controls.h" />
    <ClInclude Include="..\core\vpn_session.h" />
    <ClInclude Include="..\core\tunnel.h" />
    <ClInclude Include="..\core\posture.h" />
    <ClInclude Include="..\core\hmac.h" />
    <ClInclude Include="..\core\device.h" />
    <ClInclude Include="..\..\lib\common\include\proto.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="vpn_gui.rc" />
    <None Include="app.ico" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
